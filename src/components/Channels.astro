---
/** RSS plus whichever channels are filled in within site.config.ts (LIVE-03). */
import { SITE } from '../site.config';
import { href } from '../lib/util';
import { channelLinks } from '../lib/channels';

const links = [{ label: 'RSS FEED', url: href('/rss.xml'), me: false }, ...channelLinks(SITE.channels)];
---

<div class="channels">
  {
    links.map((l) => (
      <a href={l.url} rel={l.me ? 'me noopener' : undefined} target={l.me ? '_blank' : undefined}>
        {l.label}
      </a>
    ))
  }
</div>

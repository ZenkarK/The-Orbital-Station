---
import { SITE, ANALYTICS } from '../site.config';
import { href } from '../lib/util';
import SectionHead from './SectionHead.astro';
import Channels from './Channels.astro';

const year = new Date().getUTCFullYear();
const cols = [
  { h: 'STATION', links: [['/', 'BRIDGE'], ['/manual/', 'MANUAL'], ['/orbits/', 'ORBITS'], ['/observer/', 'OBSERVER'], ['/professional/', 'PROFESSIONAL'], ['/now/', 'NOW']] },
  { h: 'RECORD', links: [['/transmissions/', 'TRANSMISSIONS'], ['/log/', 'FLIGHT LOG'], ['/library/', 'LIBRARY'], ['/trajectories/', 'TRAJECTORIES']] },
  { h: 'INDEX', links: [['/tags/', 'TAGS'], ['/search/', 'SEARCH'], ['/rss.xml', 'RSS FEED'], ['/sitemap-index.xml', 'SITEMAP']] },
];
---

<footer class="site-foot">
  <div class="panel reg signal">
    <SectionHead tag="SIGNAL" />
    <div class="signal-grid">
      <div>
        <p class="signal-lede">
          New transmissions go out over RSS. Point any feed reader at the station and you'll hear it the moment
          something is sent.
        </p>
        <Channels />
      </div>
      <nav class="foot-nav" aria-label="Footer">
        {
          cols.map((c) => (
            <div>
              <h2>{c.h}</h2>
              <ul>
                {c.links.map(([to, label]) => (
                  <li>
                    <a href={href(to)}>{label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
  </div>
  <p class="foot-line">
    KEPT BY {SITE.author.toUpperCase()} — SYSTEMS ENGINEER IN MEDICAL IMAGING · ASTROPHYSICIST BY TRAINING · {SITE.latitude}<br />
    © {year} · SET IN ARCHIVO &amp; SPACE MONO · BUILT STATIC WITH ASTRO · {ANALYTICS.goatcounter ? 'COOKIE-FREE VISIT COUNTS, NO ADS' : 'NO TRACKING, NO ADS'}
  </p>
</footer>

---
/* The Bridge orrery: server-rendered at the logged phase (works without JS),
   then enhanced client-side — drag, keyboard, focus, reset. Nothing a visitor
   moves is saved; the logged state lives in site.config.ts. */
import { PHASE_LOGGED } from '../site.config';
import { clockToDeg, proximity, orbitRadius, orbitCountWord } from '../lib/orbits';
import { displayedOrbits, isListed } from '../lib/visibility';
import { placeLabels } from '../lib/orrery-layout';
import { href, longDate } from '../lib/util';

interface Props {
  /** Items linked to each orbit (posts + missions + holdings + trajectories). */
  counts: Record<string, number>;
}
const { counts } = Astro.props;

const C = 320;
/* Label metrics for the build (Space Mono at the desktop size); the browser re-measures. */
const LABEL = { h: 10.5, charW: 10.5 * 0.68, bodyR: 7, gap: 5 };
const rad = (d: number) => (d * Math.PI) / 180;
/* A hidden orbit has no ring here at all; a phase-only orbit keeps its ring and
   body but never a "linked" count (nothing filed there is counted). */
const bodies = displayedOrbits.map((o) => {
  const deg = clockToDeg(o.clock);
  const r = orbitRadius(o);
  const a = rad(deg);
  return {
    ...o,
    r,
    deg,
    pct: Math.round(proximity(deg) * 100),
    x: C + Math.cos(a) * r,
    y: C + Math.sin(a) * r,
    url: href(`/orbits/${o.id}/`),
    count: counts[o.id] ?? 0,
    listed: isListed(o.id),
  };
});
const ranked = [...bodies].sort((a, b) => b.pct - a.pct);
/* Nearest bodies choose their label spot first. */
const labels = Object.fromEntries(
  placeLabels(
    ranked.map((b) => ({ id: b.id, x: b.x, y: b.y, w: b.name.length * LABEL.charW })),
    { cx: C, cy: C, size: 640, h: LABEL.h, bodyR: LABEL.bodyR, gap: LABEL.gap },
  ).map((p) => [p.id, { x: p.x, y: p.y + LABEL.h * 0.35 }]),
);
/* Hide the NEAR / FAR markers when a label would sit on top of them. */
const crowds = (y: number) =>
  bodies.some((b) => Math.abs(labels[b.id].x - C) < (b.name.length * LABEL.charW) / 2 + 20 && Math.abs(labels[b.id].y - y) < 14);
const logged = longDate(new Date(PHASE_LOGGED));
const defaultCaption = `Phase is honest scheduling: whatever sits near 12 o'clock is what this season is actually for. Logged ${logged}.`;
const data = bodies.map(({ id, name, color, r, deg, desc, url, count, clock, listed }) => ({
  id, name, color, r, deg, desc, url, count, clock, listed,
}));
---

<div class="panel reg orrery-panel" data-orrery>
  <div class="orrery-hint">
    <span>FIG. 1 — SYSTEM STATE · LOGGED {PHASE_LOGGED.replaceAll('-', '.')}</span>
    <span>DRAG A BODY TO PLAY · TAP TO FOCUS · 12 O'CLOCK = NEAR</span>
  </div>
  <div class="orrery-grid">
    <svg
      class="orrery"
      viewBox="0 0 640 640"
      role="group"
      aria-label={`Orrery of ${orbitCountWord} life domains. Inner rings are the foundations, outer rings face outward. Each body's distance from 12 o'clock shows how much of this season it gets. Focus a body and use the arrow keys to move it.`}
    >
      <text x={C} y="26" text-anchor="middle" class="apsis" data-apsis="26" opacity={crowds(26) ? 0 : 1}>NEAR</text>
      <text x={C} y="624" text-anchor="middle" class="apsis" data-apsis="624" opacity={crowds(624) ? 0 : 1}>FAR</text>
      <line x1={C} y1="34" x2={C} y2="44" class="tick"></line>
      {bodies.map((b) => <circle class="track" cx={C} cy={C} r={b.r} stroke={b.color} data-track={b.id} />)}
      <g>
        <line x1={C - 10} y1={C} x2={C + 10} y2={C} class="center"></line>
        <line x1={C} y1={C - 10} x2={C} y2={C + 10} class="center"></line>
        <circle cx={C} cy={C} r="5.5" class="center"></circle>
      </g>
      {
        bodies.map((b) => (
          <circle
            class="body"
            cx={b.x.toFixed(2)}
            cy={b.y.toFixed(2)}
            r={LABEL.bodyR}
            fill={b.color}
            data-body={b.id}
            tabindex="0"
            role="slider"
            aria-label={`${b.name} phase`}
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow={b.pct}
            aria-valuetext={`${b.pct}% near, ${b.clock} o'clock`}
          />
        ))
      }
      {
        bodies.map((b) => (
          <text class="blabel" x={labels[b.id].x.toFixed(2)} y={labels[b.id].y.toFixed(2)} text-anchor="middle" data-label={b.id}>
            {b.name}
          </text>
        ))
      }
    </svg>
    <div>
      <div class="state-list" data-state-list>
        {
          ranked.map((b) => (
            <button type="button" class="state-row" data-orbit={b.id} aria-pressed="false">
              <span class="sq" style={`background:${b.color}`} />
              <span>
                {b.name}
                <span class="bar-wrap">
                  <span class="bar-fill" style={`width:${b.pct}%;color:${b.color}`} />
                </span>
              </span>
              <span class="pct">{b.pct}%</span>
            </button>
          ))
        }
      </div>
      <p class="state-caption" data-caption aria-live="polite">{defaultCaption}</p>
      <button type="button" class="btn orrery-reset" data-reset hidden>RESET TO LOGGED STATE</button>
    </div>
  </div>
  <script type="application/json" data-orrery-data set:html={JSON.stringify({ bodies: data, defaultCaption })} />
</div>

<script>
  import { placeLabels } from '../lib/orrery-layout';

  type Body = {
    id: string; name: string; color: string; r: number; deg: number; desc: string;
    url: string; count: number; clock: string; listed: boolean;
  };

  const root = document.querySelector<HTMLElement>('[data-orrery]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const { bodies, defaultCaption } = JSON.parse(root.querySelector('[data-orrery-data]')!.textContent!) as {
      bodies: Body[];
      defaultCaption: string;
    };
    const svg = root.querySelector<SVGSVGElement>('svg')!;
    const list = root.querySelector<HTMLElement>('[data-state-list]')!;
    const caption = root.querySelector<HTMLElement>('[data-caption]')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const C = 320;
    const rad = (d: number) => (d * Math.PI) / 180;
    const prox = (d: number) => Math.round(((1 - Math.sin(rad(d))) / 2) * 100);
    const toClock = (d: number) => {
      let h = (((d + 90) / 30) % 12 + 12) % 12;
      let hh = Math.floor(h);
      let mm = Math.round((h - hh) * 60);
      if (mm === 60) (hh += 1), (mm = 0);
      return `${hh % 12 || 12}:${String(mm).padStart(2, '0')}`;
    };
    const logged = Object.fromEntries(bodies.map((b) => [b.id, b.deg]));
    const phase: Record<string, number> = { ...logged };
    const bodyEl = (id: string) => svg.querySelector<SVGCircleElement>(`[data-body="${id}"]`)!;
    const labelEl = (id: string) => svg.querySelector<SVGTextElement>(`[data-label="${id}"]`)!;
    const trackEl = (id: string) => svg.querySelector<SVGCircleElement>(`[data-track="${id}"]`)!;
    let selected: string | null = null;
    let touched = false;

    /* Label sizes come from the rendered text, so the mobile font size is respected. */
    const measure = () => {
      const cs = getComputedStyle(labelEl(bodies[0].id));
      const bodyR = parseFloat(getComputedStyle(bodyEl(bodies[0].id)).getPropertyValue('r'));
      return {
        h: parseFloat(cs.fontSize) || 10.5,
        bodyR: bodyR || bodyEl(bodies[0].id).r.baseVal.value,
        w: Object.fromEntries(bodies.map((b) => [b.id, labelEl(b.id).getComputedTextLength()])),
      };
    };
    let metrics = measure();

    function position() {
      const at = (b: Body) => {
        const a = rad(phase[b.id]);
        return { x: C + Math.cos(a) * b.r, y: C + Math.sin(a) * b.r };
      };
      for (const b of bodies) {
        const { x, y } = at(b);
        const el = bodyEl(b.id);
        el.setAttribute('cx', x.toFixed(2));
        el.setAttribute('cy', y.toFixed(2));
        const p = prox(phase[b.id]);
        el.setAttribute('aria-valuenow', String(p));
        el.setAttribute('aria-valuetext', `${p}% near, ${toClock(phase[b.id])} o'clock`);
        labelEl(b.id).classList.toggle('dim', !!selected && selected !== b.id);
        trackEl(b.id).classList.toggle('sel', selected === b.id);
      }
      // The selected body labels first, then the nearest ones.
      const order = [...bodies].sort(
        (a, b) => Number(b.id === selected) - Number(a.id === selected) || prox(phase[b.id]) - prox(phase[a.id]),
      );
      const placed = placeLabels(
        order.map((b) => ({ id: b.id, ...at(b), w: metrics.w[b.id] })),
        { cx: C, cy: C, size: 640, h: metrics.h, bodyR: metrics.bodyR, gap: 5 },
      );
      for (const p of placed) {
        const lab = labelEl(p.id);
        lab.setAttribute('x', p.x.toFixed(2));
        lab.setAttribute('y', (p.y + metrics.h * 0.35).toFixed(2));
      }
      svg.querySelectorAll<SVGTextElement>('[data-apsis]').forEach((t) => {
        const y = Number(t.dataset.apsis);
        const crowded = placed.some((p) => Math.abs(p.x - C) < metrics.w[p.id] / 2 + 20 && Math.abs(p.y - y) < metrics.h + 6);
        t.setAttribute('opacity', crowded ? '0' : '1');
      });
    }

    const remeasure = () => {
      metrics = measure();
      position();
    };
    matchMedia('(max-width: 600px)').addEventListener('change', remeasure);
    document.fonts?.ready.then(remeasure);

    function renderList() {
      const rows = bodies.map((b) => ({ b, p: prox(phase[b.id]) })).sort((x, y) => y.p - x.p);
      list.innerHTML = rows
        .map(
          ({ b, p }) =>
            `<button type="button" class="state-row" data-orbit="${b.id}" aria-pressed="${selected === b.id}">` +
            `<span class="sq" style="background:${b.color}"></span>` +
            `<span>${b.name}<span class="bar-wrap"><span class="bar-fill" style="width:${p}%;color:${b.color}"></span></span></span>` +
            `<span class="pct">${p}%</span></button>`,
        )
        .join('');
    }

    function renderCaption() {
      if (!selected) {
        caption.textContent = touched
          ? "You're flying the orrery now — nothing you move here is saved. Reset to see the logged state."
          : defaultCaption;
        return;
      }
      const b = bodies.find((x) => x.id === selected)!;
      const p = prox(phase[b.id]);
      // Phase-only orbits show phase only — no "linked" count, this orbit's logs are private.
      const linked = b.listed ? ` · ${b.count} LINKED` : '';
      const desc = b.listed ? b.desc : `${b.desc} This orbit's logs are private.`;
      caption.innerHTML =
        `<b>${b.name} · ${p}% NEAR · ${toClock(phase[b.id])}${linked}</b><br>` +
        `${desc}<br><a href="${b.url}">OPEN THE ${b.name} ORBIT →</a>`;
    }

    function select(id: string | null) {
      selected = selected === id ? null : id;
      position();
      renderList();
      renderCaption();
    }

    function markTouched() {
      if (!touched) {
        touched = true;
        reset.hidden = false;
      }
    }

    /* --- pointer: generous hit areas so bodies are easy to grab on touch --- */
    let dragging: string | null = null;
    let moved = false;
    const toSvg = (ev: PointerEvent) => {
      const r = svg.getBoundingClientRect();
      return { x: ((ev.clientX - r.left) * 640) / r.width, y: ((ev.clientY - r.top) * 640) / r.height };
    };
    svg.addEventListener('pointerdown', (ev) => {
      const p = toSvg(ev);
      let best: string | null = null;
      let bestD = 30;
      for (const b of bodies) {
        const a = rad(phase[b.id]);
        const d = Math.hypot(p.x - (C + Math.cos(a) * b.r), p.y - (C + Math.sin(a) * b.r));
        if (d < bestD) (bestD = d), (best = b.id);
      }
      if (best) {
        ev.preventDefault();
        dragging = best;
        moved = false;
        svg.classList.add('dragging');
        svg.setPointerCapture(ev.pointerId);
      } else if (Math.hypot(p.x - C, p.y - C) < 22 && selected) {
        select(null);
      }
    });
    svg.addEventListener('pointermove', (ev) => {
      if (!dragging) return;
      const p = toSvg(ev);
      const a = (Math.atan2(p.y - C, p.x - C) * 180) / Math.PI;
      if (!moved && Math.abs(((a - phase[dragging] + 540) % 360) - 180) > 1.5) moved = true;
      if (moved) {
        phase[dragging] = a;
        markTouched();
        position();
        renderList();
      }
    });
    const end = () => {
      if (!dragging) return;
      const id = dragging;
      dragging = null;
      svg.classList.remove('dragging');
      if (moved) renderCaption();
      else select(id);
    };
    svg.addEventListener('pointerup', end);
    svg.addEventListener('pointercancel', end);

    /* --- keyboard: arrows move a focused body, Enter/Space focuses its orbit --- */
    svg.addEventListener('keydown', (ev) => {
      const id = (ev.target as Element).getAttribute('data-body');
      if (!id) return;
      const step = ev.shiftKey ? 15 : 5;
      if (['ArrowRight', 'ArrowDown'].includes(ev.key)) phase[id] += step;
      else if (['ArrowLeft', 'ArrowUp'].includes(ev.key)) phase[id] -= step;
      else if (ev.key === 'Enter' || ev.key === ' ') {
        ev.preventDefault();
        select(id);
        return;
      } else return;
      ev.preventDefault();
      markTouched();
      position();
      renderList();
      renderCaption();
    });

    list.addEventListener('click', (ev) => {
      const row = (ev.target as Element).closest<HTMLElement>('[data-orbit]');
      if (row) select(row.dataset.orbit!);
    });

    /* --- reset / intro animation --- */
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    function animateTo(
      target: Record<string, number>,
      from: Record<string, number>,
      { shortest = true, done }: { shortest?: boolean; done?: () => void } = {},
    ) {
      if (reduce) {
        Object.assign(phase, target);
        position();
        renderList();
        done?.();
        return;
      }
      const t0 = performance.now();
      const frame = (t: number) => {
        let running = false;
        bodies.forEach((b, i) => {
          const dur = 1100 + i * 140;
          const k = Math.min(1, (t - t0) / dur);
          if (k < 1) running = true;
          const e = 1 - Math.pow(1 - k, 3);
          const raw = target[b.id] - from[b.id];
          const delta = shortest ? ((raw % 360) + 540) % 360 - 180 : raw;
          phase[b.id] = from[b.id] + delta * e;
        });
        position();
        renderList();
        if (running) requestAnimationFrame(frame);
        else {
          Object.assign(phase, target);
          position();
          renderList();
          done?.();
        }
      };
      requestAnimationFrame(frame);
    }

    reset.addEventListener('click', () => {
      touched = false;
      reset.hidden = true;
      animateTo(logged, { ...phase }, { done: renderCaption });
      renderCaption();
    });

    // Bodies swing clockwise into their logged positions on arrival.
    if (!reduce) {
      const intro = Object.fromEntries(bodies.map((b, i) => [b.id, logged[b.id] - 140 - i * 12]));
      Object.assign(phase, intro);
      position();
      animateTo(logged, intro, { shortest: false });
    }
  }
</script>

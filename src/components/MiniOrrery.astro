---
/** Static orrery highlighting a single orbit — used on orbit pages. */
import { ORBITS } from '../site.config';
import { clockToDeg } from '../lib/orbits';

interface Props {
  focus: string;
}
const { focus } = Astro.props;
const C = 320;
const rad = (d: number) => (d * Math.PI) / 180;
const bodies = ORBITS.map((o) => {
  const a = rad(clockToDeg(o.clock));
  return { ...o, x: C + Math.cos(a) * o.r, y: C + Math.sin(a) * o.r, on: o.id === focus };
});
---

<svg class="orrery" viewBox="0 0 640 640" role="img" aria-label={`Position of the ${focus} orbit in the current phase`}>
  <text x={C} y="26" text-anchor="middle" class="apsis">NEAR</text>
  <text x={C} y="624" text-anchor="middle" class="apsis">FAR</text>
  {bodies.map((b) => <circle class={`track${b.on ? ' sel' : ''}`} cx={C} cy={C} r={b.r} stroke={b.color} />)}
  <line x1={C - 10} y1={C} x2={C + 10} y2={C} class="center"></line>
  <line x1={C} y1={C - 10} x2={C} y2={C + 10} class="center"></line>
  <circle cx={C} cy={C} r="5.5" class="center"></circle>
  {
    bodies.map((b) => (
      <circle
        cx={b.x.toFixed(2)}
        cy={b.y.toFixed(2)}
        r={b.on ? 14 : 7}
        fill={b.color}
        fill-opacity={b.on ? 1 : 0.35}
        stroke="var(--panel)"
        stroke-width="2"
      />
    ))
  }
</svg>

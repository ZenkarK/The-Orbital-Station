---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import Sq from '../../components/Sq.astro';
import { getPosts, getProjects, getLibrary } from '../../lib/content';
import { orbitProximity, phaseLabel, orbitCountWord, capitalize } from '../../lib/orbits';
import { displayedOrbits, isListed } from '../../lib/visibility';
import { href } from '../../lib/util';

const [posts, projects, library] = await Promise.all([getPosts(), getProjects(), getLibrary()]);
/* A hidden orbit has no row at all. A phase-only orbit gets a row (body + phase),
   but never counts — posts/projects/library are already filtered to public
   orbits, so a phase-only orbit's counts would always read zero; say so instead. */
const rows = displayedOrbits.map((o) => {
  const pct = Math.round(orbitProximity(o) * 100);
  if (!isListed(o.id)) return { o, pct, private: true as const };
  const tx = posts.filter((p) => p.data.orbit === o.id).length;
  const ms = projects.filter((p) => p.data.orbit === o.id).length;
  const lib = library.filter((l) => l.data.orbit === o.id).length;
  return { o, pct, tx, ms, lib, private: false as const };
});
---

<Base title="Orbits" description={`The ${orbitCountWord} domains of the Orbital Model and everything filed under each.`}>
  <div class="page">
    <SectionHead tag="INDEX" link={{ href: '/manual/', label: 'READ THE MANUAL →' }} />
    <h1 class="title">The {capitalize(orbitCountWord)} Orbits</h1>
    <p class="sec-sub">Every transmission, mission and library holding belongs to one orbit. Open one to see its whole record.</p>
    <div class="panel" style="padding:4px 20px">
      {
        rows.map((row) => (
          <a class="orbit-row" href={href(`/orbits/${row.o.id}/`)}>
            <Sq orbit={row.o.id} />
            <b>{row.o.name}</b>
            <span>
              {row.o.desc}
              <br />
              <small style="font-family:var(--mono);font-size:9.5px;letter-spacing:.16em;color:var(--faint)">
                {row.private ? 'LOGS PRIVATE' : `${row.tx} TX · ${row.ms} MISSIONS · ${row.lib} HOLDINGS`}
              </small>
            </span>
            <span class="pct">
              {row.pct}% · {phaseLabel(row.pct)}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</Base>

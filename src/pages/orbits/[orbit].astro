---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import TxItem from '../../components/TxItem.astro';
import MissionCard from '../../components/MissionCard.astro';
import MiniOrrery from '../../components/MiniOrrery.astro';
import Sq from '../../components/Sq.astro';
import { SITE, type Orbit } from '../../site.config';
import { getPosts, getProjects, getLibrary, getTrajectories, postsForProject } from '../../lib/content';
import { orbitProximity, phaseLabel } from '../../lib/orbits';
import { displayedOrbits, visibilityOf } from '../../lib/visibility';
import { href } from '../../lib/util';
import { breadcrumbLd } from '../../lib/structured-data';

/* A hidden orbit gets no page at all: not in getStaticPaths, so it 404s.
   prev/next walk the displayed ring only, so navigation never lands on one. */
export function getStaticPaths() {
  return displayedOrbits.map((o, i) => ({
    params: { orbit: o.id },
    props: {
      o,
      prev: displayedOrbits[(i - 1 + displayedOrbits.length) % displayedOrbits.length],
      next: displayedOrbits[(i + 1) % displayedOrbits.length],
    },
  }));
}
interface Props {
  o: Orbit;
  prev: Orbit;
  next: Orbit;
}
const { o, prev, next } = Astro.props;

const [allPosts, allProjects, allLibrary, allTraj] = await Promise.all([
  getPosts(),
  getProjects(),
  getLibrary(),
  getTrajectories(),
]);
const posts = allPosts.filter((p) => p.data.orbit === o.id);
const projects = allProjects.filter((p) => p.data.orbit === o.id);
const library = allLibrary.filter((l) => l.data.orbit === o.id);
const trajectories = allTraj.filter((t) => t.data.orbit === o.id);
const pct = Math.round(orbitProximity(o) * 100);
/* An empty orbit says why, in terms of where it sits this season. */
const EMPTY_BY_PHASE: Record<string, string> = {
  NEAR: "IT'S RUNNING CLOSE THIS SEASON; THE FIRST ENTRY IS STILL BEING WRITTEN.",
  'MID-ORBIT': "IT'S IN MID-ORBIT, BETWEEN SEASONS.",
  FAR: "IT'S COASTING ON THE FAR SIDE.",
};
const name = o.name.charAt(0) + o.name.slice(1).toLowerCase();
const nothing = !posts.length && !projects.length && !library.length && !trajectories.length;
/* phase-only: the body and its phase still show, but nothing filed there is
   counted or listed — so instead of the counts row and empty-state copy, say so. */
const phaseOnly = visibilityOf(o) === 'phase-only';
// GROW-02: only a public orbit has anything to feed — a phase-only orbit's posts never
// become pages at all (src/lib/content.ts), so there's no orbits/[orbit]/rss.xml for it.
const feedHref = href(`/orbits/${o.id}/rss.xml`);
const jsonLd = breadcrumbLd(
  [
    { name: 'Home', path: '/' },
    { name: 'Orbits', path: '/orbits/' },
    { name: o.name, path: `/orbits/${o.id}/` },
  ],
  Astro.site!,
);
// READ-02: the card draws only on `o.name`/`o.color`/`o.desc` and phase — the same
// config-level things this page shows a phase-only orbit, never a count or title.
const ogImage = href(`/og/orbits/${o.id}.png`);
const ogImageAlt = `${name} orbit — Orbital Station.`;
---

<Base
  title={`${name} orbit`}
  description={o.desc}
  image={ogImage}
  imageAlt={ogImageAlt}
  feeds={phaseOnly ? [] : [{ href: feedHref, title: `${SITE.name} — ${o.name}` }]}
  jsonLd={jsonLd}
>
  <div class="page">
    <a class="backlink" href={href('/orbits/')}>← ALL ORBITS</a>
    <div class="orbit-hero">
      <div>
        <SectionHead tag={`ORBIT · ${o.name}`} />
        <h1 class="title" style="display:flex;align-items:center;gap:.3em">
          <span class="sq" style={`background:${o.color};width:.42em;height:.42em`}></span>{name}
        </h1>
        <p class="sec-sub">{o.desc}</p>
        <div class="panel spec" style="max-width:420px">
          <div class="spec-row"><span>PHASE</span><b>{pct}% · {phaseLabel(pct)}</b></div>
          <div class="spec-row"><span>CLOCK POSITION</span><b>{o.clock}</b></div>
          {
            phaseOnly ? (
              <div class="spec-row"><span>LOGS</span><b>PRIVATE</b></div>
            ) : (
              <div class="spec-row"><span>TRANSMISSIONS · MISSIONS · HOLDINGS</span><b>{posts.length} · {projects.length} · {library.length}</b></div>
            )
          }
          {!phaseOnly && <div class="spec-row"><span>FEED</span><b><a href={feedHref}>ORBIT RSS →</a></b></div>}
        </div>
      </div>
      <div class="panel reg mini-orrery">
        <MiniOrrery focus={o.id} />
      </div>
    </div>

    {
      posts.length > 0 && (
        <section class="block" aria-labelledby="o-tx">
          <SectionHead
            tag="TRANSMISSIONS"
            link={{ href: `/transmissions/?orbit=${o.id}`, label: 'FILTERED LIST →' }}
          />
          <h2 id="o-tx" class="sr-only">Transmissions</h2>
          <div class="tx-list">
            {posts.map((p) => (
              <TxItem post={p} />
            ))}
          </div>
        </section>
      )
    }

    {
      projects.length > 0 && (
        <section class="block" aria-labelledby="o-ms">
          <SectionHead tag="MISSIONS" />
          <h2 id="o-ms" class="sr-only">Missions</h2>
          <div class="mission-cards">
            {projects.map((p) => (
              <MissionCard project={p} txCount={postsForProject(allPosts, p.id).length} />
            ))}
          </div>
        </section>
      )
    }

    {
      trajectories.length > 0 && (
        <section class="block" aria-labelledby="o-tr">
          <SectionHead tag="TRAJECTORIES" link={{ href: '/trajectories/', label: 'VISION BOARD →' }} />
          <h2 id="o-tr" class="sr-only">Trajectories</h2>
          <div class="traj-grid">
            {trajectories.map((t) => (
              <article class:list={['panel traj', { reached: t.data.reached }]} style="min-height:0">
                {t.data.reached && <span class="stamp">REACHED</span>}
                <h3>{t.data.title}</h3>
                <p>{t.data.note}</p>
                <div class="traj-foot">{t.data.horizon}</div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      library.length > 0 && (
        <section class="block" aria-labelledby="o-lib">
          <SectionHead tag="LIBRARY" link={{ href: '/library/', label: 'FULL LIBRARY →' }} />
          <h2 id="o-lib" class="sr-only">Library holdings</h2>
          <div class="panel">
            {library.map((b) => (
              <div class="lib" style={`border-left-color:${o.color};grid-template-columns:minmax(0,1fr) 118px`}>
                <div>
                  <div class="lib-line1">
                    <span class="lib-type">{b.data.type}</span>
                    <span class="lib-title">
                      {b.data.link ? (
                        <a href={b.data.link} target="_blank" rel="noopener noreferrer">
                          {b.data.title}
                          <span class="ext" aria-label="(opens in a new tab)">↗</span>
                        </a>
                      ) : (
                        b.data.title
                      )}
                    </span>
                    {b.data.author && <span class="lib-auth">{b.data.author}</span>}
                  </div>
                  {b.data.note && <p class="lib-note">{b.data.note}</p>}
                </div>
                <span class={`shelf ${b.data.shelf}`}>{b.data.shelf}</span>
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      phaseOnly ? (
        <p class="empty block">THIS ORBIT'S LOGS ARE PRIVATE — ONLY ITS BODY AND PHASE ARE SHOWN.</p>
      ) : (
        nothing && <p class="empty block">NOTHING FILED IN THIS ORBIT YET — {EMPTY_BY_PHASE[phaseLabel(pct)]}</p>
      )
    }

    <nav class="orbit-nav" aria-label="Other orbits">
      <a href={href(`/orbits/${prev.id}/`)}>← <Sq orbit={prev.id} />{prev.name}</a>
      <a href={href(`/orbits/${next.id}/`)}><Sq orbit={next.id} />{next.name} →</a>
    </nav>
  </div>
</Base>

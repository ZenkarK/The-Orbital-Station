---
import '../styles/fonts.css'; // subset Archivo + Space Mono (scripts/subset-fonts.mjs)
import '../styles/global.css';

import { SITE, ANALYTICS } from '../site.config';
import { href } from '../lib/util';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import Analytics from '../components/Analytics.astro';
import { orbitById } from '../lib/orbits';

interface Props {
  /** Page name; the site name is appended automatically. Omit on the home page. */
  title?: string;
  description?: string;
  /** Absolute or site-relative URL of the social card image. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  tags?: string[];
  noindex?: boolean;
  /** JSON-LD object(s) — src/lib/structured-data.ts's builders. Rendered as
      <script type="application/ld+json">, with `<` escaped so a title containing
      "</script>" can't break out of the tag. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Extra <link rel="alternate"> feeds beyond the site-wide RSS + JSON Feed (e.g. an
      orbit's own feed) — already run through href(), ready to use as-is. */
  feeds?: { href: string; title: string; type?: string }[];
  /** Id of the orbit the page belongs to (posts, missions, orbit pages) — lets analytics count per orbit. */
  orbit?: string;
}

const {
  title,
  description: rawDescription,
  image,
  imageAlt,
  type = 'website',
  published,
  modified,
  tags = [],
  noindex = false,
  jsonLd,
  feeds = [],
  orbit,
} = Astro.props;

const description = rawDescription?.trim() || SITE.description;
const fullTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? href('/og.png'), Astro.site);
const rss = href('/rss.xml');
const jsonFeed = href('/feed.json');
// A BlogPosting with no image of its own gets the same one this page already gave Base —
// one place (this) decides the og.png fallback, instead of every builder repeating it.
const jsonLdItems = (jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []).map((item) =>
  item['@type'] === 'BlogPosting' && item.image === undefined ? { ...item, image: ogImage.href } : item,
);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#23262d" />
    <meta name="color-scheme" content="dark light" />

    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Transmissions`} href={rss} />
    <link rel="alternate" type="application/feed+json" title={`${SITE.name} — Transmissions`} href={jsonFeed} />
    {feeds.map((f) => <link rel="alternate" type={f.type ?? 'application/rss+xml'} title={f.title} href={f.href} />)}
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt ?? `${SITE.name} — ${SITE.author}`} />
    {/* Every card — generated per-page or the og.png fallback — is a 1200×630 PNG. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:locale" content={SITE.locale.replace('-', '_')} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt ?? `${SITE.name} — ${SITE.author}`} />

    {
      jsonLdItems.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '\\u003c')} />
      ))
    }

    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    {ANALYTICS.goatcounter && <Analytics orbit={orbit ? orbitById(orbit).name : undefined} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">SKIP TO CONTENT</a>
    <div class="grain" aria-hidden="true"></div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SearchDialog />
  </body>
</html>
